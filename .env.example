# Backend & General
SECRET_KEY=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# External PostgreSQL Server
POSTGRES_SERVER=your_external_postgres_host_or_ip
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=net_monitoring

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhousepassword
CLICKHOUSE_DB=net_monitoring

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend Configuration (Optional: default resolves automatically to hostname:8000)
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_WS_URL=ws://localhost:8000/api/ws/realtime
